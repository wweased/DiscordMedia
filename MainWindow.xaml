<Window x:Class="DiscordMediaRPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медиа для Discord"
        Width="340" Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#14120F">

    <Window.Resources>
        <Style x:Key="ИконкаКнопка" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A8177" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="СчётчикЛенты" TargetType="ProgressBar">
            <Setter Property="Background" Value="#2A2620" />
            <Setter Property="Foreground" Value="#E8A33D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Rectangle Fill="{TemplateBinding Background}" />
                            <Rectangle x:Name="ЗаполнениеЛенты"
                                       Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left"
                                       Width="{TemplateBinding Value}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Padding="16" Background="#1E1B17" BorderBrush="#2A2620" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="ИндикаторСтатуса" Grid.Column="0" Width="8" Height="8" Fill="#8A8177"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="Discord" Foreground="#8A8177"
                           FontFamily="Bahnschrift" FontSize="12" VerticalAlignment="Center" />

                <Button Grid.Column="3" Style="{StaticResource ИконкаКнопка}"
                        Content="—" Click="СвернутьВТрей_Click" />
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                <TextBlock x:Name="ТекстНазваниеТрека"
                           Text="Ничего не играет"
                           FontFamily="Bahnschrift SemiBold Condensed"
                           FontSize="16" Foreground="#EDE6DA"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ТекстИсполнитель"
                           Text=""
                           FontFamily="Bahnschrift" FontSize="12"
                           Foreground="#8A8177" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar x:Name="ПрогрессТрека" Grid.Column="0"
                             Style="{StaticResource СчётчикЛенты}"
                             Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBlock x:Name="ТекстВремя" Grid.Column="1" Text="0:00 / 0:00"
                           FontFamily="Cascadia Mono" FontSize="11"
                           Foreground="#8A8177" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
